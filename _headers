# Cloudflare Pages / Netlify header rules
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'

/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
